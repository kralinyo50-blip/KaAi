{
  "name": "kaai-jarvis",
  "version": "1.1.0",
  "description": "KaAi - Kaan Özkurt imzalı, otomatik dinlemeli, derin sesli Jarvis asistan | Gemini 2.5",
  "main": "main.js",
  "author": "Kaan Özkurt",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "systeminformation": "^5.18.7",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kaanozkurt.kaai",
    "productName": "KaAi - AI Asistan",
    "copyright": "© 2025 Kaan Özkurt",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "KaAi-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KaAi",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": []
  }
}
